{
  "schema_version": "0.1",
  "app_name": "Furnace Monitor",
  "description": "Generated by Aditum App Builder \u2014 live governed data.",
  "reference_architecture": "dashboard_timeseries",
  "components": [
    {
      "id": "k",
      "type": "kpi_cards",
      "title": "Latest readings",
      "query": {
        "source": "timeseries",
        "tags": [
          "10MAA01TT001",
          "10MAA01TT002",
          "10MAA01PT001"
        ],
        "aggregation": "last"
      }
    },
    {
      "id": "tr",
      "type": "trend_chart",
      "title": "Trend (7d)",
      "query": {
        "source": "timeseries",
        "tags": [
          "10MAA01TT001",
          "10MAA01TT002",
          "10MAA01PT001"
        ],
        "window_days": 7
      }
    },
    {
      "id": "tb",
      "type": "table",
      "title": "Samples",
      "query": {
        "source": "timeseries",
        "tags": [
          "10MAA01TT001"
        ]
      }
    }
  ],
  "governance": {
    "rbac": "inherit_from_aditum",
    "api_keys": "scoped_read_only",
    "sandboxed": true,
    "secrets_in_client": false
  }
}